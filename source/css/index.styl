@import '_variables';

$anchor-border = $gainsboro; /* get timeline color config from __config.yml */
timeline_colors = {};

for item in hexo-config('timeline.items') {
  for key in item {
    if (key[0] == 'name') {
      c_name = key[1];
    }

    if (key[0] == 'color') {
      c_value = key[1];
    }
  }

  timeline_colors[c_name] = c_value;
}

.wall-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.wall-bg::before {
  @extend .wall-bg;
  z-index: 2;
  content: ' ';
  background-color: var(--c-wall-overlay);
  transition: background-color 200ms ease-in;
}

.wall-main:hover+.wall-bg::before {
  background-color: var(--c-wall-overlay-hover);
}

.wall-main:hover+.wall-bg .cursor {
  animation: spark 1s ease infinite;
}

.wall-main {
  cursor: pointer;
  position: relative;
  text-align: center;
  margin-top: -20vh;
  z-index: 3;
}

.wall-title {
  font-weight: 600;
  font-size: 72px;
  animation: flyIn 500ms ease-out;
}

.wall-subtitle {
  font-size: 36px;
  font-weight: bold;
  margin-top: 10px;
}

.wall-description {
  font-size: 20px;
  font-weight: 400;
  margin: 10px 0;
  font-family: sourceHanSerif;
  letter-spacing: 0.2em;
}

// 开启一言后内容随机，sourceHanSerif 子字体无法覆盖，
// 改用单一系统宋体字面，避免同一句中两种宋体字面交错
.wall-description--hitokoto {
  font-family: "Songti SC", "STSong", "SimSun", "Noto Serif CJK SC", serif;
}

#heart-curve {
  position: absolute;
  right: 0;
  top: 50%;
  margin-top: -200px;
}

.hello-world {
  position: absolute;
  top: calc(50% - 80px);
  right: calc(50% + 230px);
  font-size: 30px;
  display: flex;
  align-items: flex-end;
  width: 220px;
}

.hello-world .cursor {
  height: 2px;
  width: 20px;
  background-color: $text-color;
}

@keyframes spark {
  0% {
    opacity: 0;
  }

  50% {
    opacity: 0;
  }

  51% {
    opacity: 1;
  }

  100% {
    opacity: 1;
  }
}

.normal-eqt {
  position: absolute;
  top: calc(50% + 100px);
  right: 50%;
  opacity: 0.8;
}

.motto {
  font-size: 28px;
  font-weight: bold;
  right: 0;
  bottom: calc(50% - 200px);
  position: absolute;
  opacity: 0.3;
}

.poem {
  font-size: 18px;
  position: absolute;
  font-family: sourceHanSerif;
  left: 50%;
  top: calc(50% + 80px);
  opacity: 0.2;
}

@keyframes flyIn {
  from {
    transform: translateY(-100%);
    opacity: 0;
  }

  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.about {
  max-width: 900px;
  margin: 200px auto;
  display: flex;
  justify-content: space-between;
  // 屏幕安全边距：窄屏不贴边，兼容刘海屏/手势操作栏（env 安全区）
  box-sizing: border-box;
  padding-left: unquote('max(24px, env(safe-area-inset-left))');
  padding-right: unquote('max(24px, env(safe-area-inset-right))');
}

.about-photo {
  width: 300px;
  height: 450px;
  background: url('') center center / cover no-repeat;
  margin: 0 10px;
  transition: box-shadow 200ms ease-out, transform 200ms ease-out;

  &:hover {
    box-shadow: 0 0 14px 0 $anchor-border;
    transform: translateY(-4px);
  }
}

.about-text {
  font-weight: bold;
  font-family: sourceHanSerif;
}

.about-title {
  text-align: center;
  font-size: 40px;
  font-weight: bold;
  margin: 40px 0;
}

.about-detail {
  font-size: 20px;
  line-height: 2em;
  letter-spacing: 0.3em;
  margin: 0 10px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.about-text-p {
  padding: 20px 10px;
}

.timeline {
  max-width: 1100px;
  margin: 300px auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  // 屏幕安全边距：窄屏不贴边，兼容刘海屏/手势操作栏（env 安全区）
  box-sizing: border-box;
  padding-left: unquote('max(24px, env(safe-area-inset-left))');
  padding-right: unquote('max(24px, env(safe-area-inset-right))');
}

.timeline-head {
  display: flex;
  justify-content: center;
  align-items: center;
}

.timeline-head .title {
  font-size: 40px;
  font-weight: bold;
}

.radio-wrapper {
  display: flex;
  align-items: flex-end;
  margin: 0 10px;
}

.radio {
  position: relative;
  width: 20px;
  margin: 0 10px;
  height: 40px;
}

.radio>label {
  position: absolute;
  cursor: pointer;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  height: 100%;
  margin: auto;
}

.radio>input {
  position: absolute;
  opacity: 0;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  height: 100%;
  margin: auto;
}

.radio-skin {
  height: 100%;
  width: 2px;
  border-radius: 1px;
  background: var(--c-radio-track);
  transition: background 0.4s ease;

  &::after {
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    display: block;
    height: 20px;
    width: 20px;
    border-radius: 50%;
    background-color: var(--c-radio-thumb);
    border: 2px solid transparent;
    box-sizing: border-box;
    content: '';
    position: absolute;
    left: -9px;
    top: 22px;
    box-shadow: 1px 0 5px rgba(0, 0, 0, 0.2);
  }
}

for v, k in timeline_colors {
  .radio-skin--{v} {
    @extend .radio-skin;

    &::after {
      border-color: convert(k);
    }
  }

  #radio-{v}:checked+.radio-skin--{v} {
    background-color: convert(k);

    &::after {
      background-color: convert(k);
      top: -2px;
    }
  }

  .timeline-item-{v}, .timeline-item-{v}--hidden {
    .line-anchor::after {
      background-color: convert(k);
    }

    .line-date-tag {
      background-color: convert(k);
    }
  }

  /*
  .timeline-item-app, .timeline-item-event {
    font-weight: bold;
  }
  */
}

.timeline-body {
  width: 100%;
}

.line-anchor::after {
  content: '';
  position: absolute;
  height: 16px;
  width: 16px;
  border-radius: 50%;
  right: -9px;
  bottom: 0;
  left: -9px;
  top: 0;
  margin: auto;
  border: 2px solid $anchor-border;
}

.line-anchor {
  position: relative;
  height: 20px;
  margin: 10px 4px;
  flex: 0 0 20px;
}

.line-date, .line-title {
  flex: 1;
  display: flex;
  align-items: center;
}

.line-date {
  justify-content: flex-end;
}

.line-title .text-icon {
  margin: 0 8px;
}

.timeline-list {
  position: relative;
}

.timeline-list::before {
  position: absolute;
  content: '';
  top: -20px;
  left: 0;
  right: 0;
  bottom: -20px;
  margin: 0 auto;
  width: 2px;
  background-color: $anchor-border;
  z-index: -1;
}

.timeline-post {
  text-decoration: none;
}

.timeline-item {
  width: 100%;
  display: flex;
  padding: 20px 0;
  justify-content: flex-start;
  align-items: center;
  font-size: 18px;
  overflow: hidden;
  transition: height 200ms ease-out, padding 200ms ease-out, transform 200ms ease-out, opacity 200ms ease-out;
  transition-delay: 200ms;
  height: 80px;

  &-first, &-last {
    @extend .timeline-item;
    height: auto;
    padding: 0;
    justify-content: center;
  }

  &:nth-child(even) {
    flex-direction: row-reverse;

    .line-title {
      justify-content: flex-end;
    }

    .line-date {
      justify-content: flex-start;
    }
  }
}

.timeline-item--hidden {
  @extend .timeline-item;
  height: 0;
  padding: 0;
  transform: rotateX(90deg);
  opacity: 0;
}

.line-anchor--now, .line-anchor--end {
  height: 40px;
  background: none;
}

.icon-anchor {
  position: absolute;
  left: -20px;
  right: -20px;
  height: 41px;
  width: 41px;
  top: 23px;
}

.line-anchor--end::after {
  background-color: $anchor-border;
}

.line-anchor--now::after {
  border: 2px solid $anchor-border;
}

.line-date-tag {
  display: inline-block;
  font-size: 14px;
  color: var(--c-on-accent);
  padding: 0 4px;
  border-radius: 3px;
}

@media (hover: none) {
  .wall-bg .cursor {
    animation: spark 1s ease infinite;
  }
}

/* 关于页 */
.about-page {
  max-width: 760px;
  margin: 120px auto 200px;
  padding: 0 20px;

  &__title {
    text-align: center;
    font-size: 40px;
    font-weight: bold;
    font-family: sourceHanSerif;
    margin-bottom: 40px;
  }

  &__content {
    font-size: 18px;
    line-height: 2em;
    letter-spacing: 0.1em;

    p {
      margin: 0 0 1em;
    }
  }

  &__rss {
    display: inline-block;
    margin-top: 40px;
    font-size: 16px;
    color: $text-color;
    text-decoration: none;
    border-bottom: 1px solid $gainsboro;
    padding-bottom: 2px;
    transition: color 200ms ease;

    &:hover {
      color: var(--c-accent-soft);
    }
  }
}

/* 首页最近更新卡片 */
.recent-updates {
  max-width: 900px;
  margin: 200px auto;
  // 屏幕安全边距：窄屏不贴边，兼容刘海屏/手势操作栏（env 安全区）
  box-sizing: border-box;
  padding-left: unquote('max(24px, env(safe-area-inset-left))');
  padding-right: unquote('max(24px, env(safe-area-inset-right))');

  &__head {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 30px;
  }

  &__title {
    font-size: 36px;
    font-weight: bold;
    font-family: sourceHanSerif;
  }

  &__rss {
    margin-left: 14px;
    font-size: 14px;
    color: var(--c-text);
    background: $gainsboro;
    border-radius: 3px;
    padding: 2px 8px;
    text-decoration: none;
    transition: background 200ms ease;

    &:hover {
      background: var(--c-accent-soft);
    }
  }

  &__viewport {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  &__track {
    position: relative;
    flex: 1;
    // 允许窄屏收缩（flex 项默认 min-width:auto 会把两侧箭头挤出屏幕）
    min-width: 0;
    min-height: 160px;
    margin: 0 10px;
  }

  &__arrow {
    cursor: pointer;
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 50%;
    background: $whitesmoke;
    color: $text-color;
    font-size: 22px;
    line-height: 1;
    transition: background 200ms ease;

    &:hover {
      background: $gainsboro;
    }
  }

  &__dots {
    display: flex;
    justify-content: center;
    margin-top: 18px;
  }

  &__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: $whitesmoke;
    margin: 0 5px;
    cursor: pointer;
    transition: background 200ms ease;

    &.is-active {
      background: $gainsboro;
    }
  }
}

.recent-card {
  display: none;
  max-width: 600px;
  // 允许窄屏收缩；外部 RSS 文本不可控（可能含长串无空格字符），
  // anywhere 使超长词也可断行，避免把卡片/箭头撑出屏幕
  min-width: 0;
  overflow-wrap: anywhere;
  margin: 0 auto;
  padding: 24px 28px;
  background: var(--c-bg-card);
  border: 1px solid var(--c-border);
  border-radius: 8px;
  box-shadow: 0 2px 12px var(--c-shadow);
  text-align: center;
  // 最近更新内容（日期/标题/摘要）统一使用宋体，与主题标题字面一致；
  // 同 recent-card__title 的理由：外部 RSS 字符不受子集字体覆盖，
  // 直接使用单一系统宋体字面，避免同一文本内两种宋体交错
  font-family: "Songti SC", "STSong", "SimSun", "Noto Serif CJK SC", serif;

  &.is-active {
    display: block;
    animation: fadeIn 300ms ease;
  }

  &__date {
    font-size: 13px;
    color: $gainsboro;
    margin-bottom: 10px;
  }

  &__title {
    display: block;
    font-size: 22px;
    font-weight: bold;
    // 标题来自外部 RSS，内容不可控；sourceHanSerif 是从主题配置文本提取的子字体，
    // 无法覆盖外部字符。若以 sourceHanSerif 为主字体，未覆盖字符会 fallback 到另一
    // 种系统宋体，导致同一标题内两种宋体字面交错。故直接使用单一系统宋体字面，
    // 保证整段标题字形统一。
    font-family: "Songti SC", "STSong", "SimSun", "Noto Serif CJK SC", serif;
    color: var(--c-text-heading);
    text-decoration: none;
    margin-bottom: 12px;
    transition: color 200ms ease;

    &:hover {
      color: var(--c-accent-soft);
    }
  }

  &__excerpt {
    font-size: 15px;
    line-height: 1.8em;
    color: var(--c-text-soft);
    margin: 0;
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(6px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media screen and (max-width: 1023px) {
  .wall {
    height: calc(100vh - 60px);
  }

  .hello-world {
    left: 20px;
  }

  .about {
    margin: 100px auto;
    flex-direction: column-reverse;
    justify-content: center;
    align-items: center;
  }

  .about-text {
    margin-bottom: 50px;
  }

  .about-detail {
    text-align: center;
  }
}

@media screen and (max-width: 415px) {
  .timeline {
    margin: 200px auto;
  }

  .timeline-list {
    .timeline-item {
      flex-direction: column;
      height: auto;
    }

    .line-date {
      border-radius: 4px;
      border: 2px solid $whitesmoke;
    }

    .line-title {
      background: var(--c-bg-card);
      border-radius: 4px;
      border: 2px solid var(--c-border);
      padding: 4px;
    }
  }

  .about-detail {
    font-size: $font-size-base;
  }

  .hello-world {
    top: 15%;
  }

  #heart-curve {
    top: 60%;
    right: 10%;
    width: 300px;
  }

  .normal-eqt {
    bottom: 14%;
    left: 40%;
    top: auto;

    img {
      width: 200px;
    }
  }
}

/* ===== 项目展示（projects.enable 控制） ===== */
.projects {
  max-width: 900px;
  margin: 100px auto;
  // 屏幕安全边距：窄屏不贴边，兼容刘海屏/手势操作栏（env 安全区）
  box-sizing: border-box;
  padding-left: unquote('max(24px, env(safe-area-inset-left))');
  padding-right: unquote('max(24px, env(safe-area-inset-right))');
}

.projects__title {
  text-align: center;
  font-size: 36px;
  font-weight: bold;
  font-family: sourceHanSerif;
  margin-bottom: 30px;
}

.projects__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 20px;
}

.project-card {
  display: flex;
  flex-direction: column;
  background: var(--c-bg-card);
  border: 1px solid var(--c-border);
  border-radius: 6px;
  padding: 18px 20px;
  box-shadow: 0 1px 2px var(--c-shadow);
  transition: box-shadow 200ms ease-out, transform 200ms ease-out;

  &:hover {
    box-shadow: 0 4px 12px var(--c-shadow);
    transform: translateY(-2px);
  }
}

.project-card__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.project-card__name {
  font-size: 20px;
  font-weight: bold;
  color: var(--c-text-heading);
  text-decoration: none;

  &:hover {
    color: var(--c-accent-hover);
  }
}

.project-card__repo {
  flex: 0 0 auto;
  margin-left: 10px;
  color: var(--c-text-muted);
  text-decoration: none;
  font-size: 16px;

  &:hover {
    color: var(--c-accent-hover);
  }
}

.project-card__desc {
  flex: 1;
  margin: 10px 0;
  font-size: $font-size-small;
  line-height: 1.8;
  color: var(--c-text-soft);
}

.project-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.project-card__tag {
  font-size: $font-size-smallest;
  color: var(--c-text-soft);
  background: var(--c-bg-muted);
  border: 1px solid var(--c-border);
  border-radius: 3px;
  padding: 1px 8px;
}

/* ===== 技能展示（skills.enable 控制） ===== */
.skills {
  max-width: 900px;
  margin: 100px auto;
  // 屏幕安全边距：窄屏不贴边，兼容刘海屏/手势操作栏（env 安全区）
  box-sizing: border-box;
  padding-left: unquote('max(24px, env(safe-area-inset-left))');
  padding-right: unquote('max(24px, env(safe-area-inset-right))');
}

.skills__title {
  text-align: center;
  font-size: 36px;
  font-weight: bold;
  font-family: sourceHanSerif;
  margin-bottom: 30px;
}

.skills__groups {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 34px 40px;
}

.skills__group-name {
  font-size: 18px;
  font-weight: bold;
  color: var(--c-text-heading);
  margin-bottom: 16px;
}

.skills__group-body {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.skill-item__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  font-size: $font-size-small;
  color: var(--c-text-soft);
  margin-bottom: 6px;
}

// 技能名：允许在窄屏优雅折行（配合下方 pct 不压缩，两者不会挤在一起错位）
.skill-item__name {
  min-width: 0;
  overflow-wrap: break-word;
}

// 百分比数值：固定不压缩、不折行，始终贴齐进度条右端
.skill-item__pct {
  flex: 0 0 auto;
  color: var(--c-text-muted);
  font-variant-numeric: tabular-nums;
}

.skill-item__bar {
  height: 6px;
  border-radius: 3px;
  background: var(--c-bg-muted);
  overflow: hidden;
}

.skill-item__fill {
  height: 100%;
  border-radius: 3px;
  background: var(--c-accent-soft);
  transition: width 400ms ease-out;
}

// 无 level 的技能：收纳为一行可换行标签，字号/配色与技能名一致，保持视觉统一
.skill-item__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 2px;
}

.skill-item__tag {
  font-size: $font-size-small;
  line-height: 1.6;
  color: var(--c-text-soft);
  background: var(--c-bg-muted);
  border: 1px solid var(--c-border);
  border-radius: 3px;
  padding: 2px 10px;
}

@media screen and (max-width: 415px) {
  .projects,
  .skills {
    margin: 60px auto;
  }

  .skills__groups {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  // 窄屏单列下增加条目间距，保证呼吸感
  .skills__group-body {
    gap: 18px;
  }

  // 窄屏轮播：缩小箭头与轨道边距，给卡片让出宽度
  .recent-updates__arrow {
    width: 34px;
    height: 34px;
    font-size: 18px;
  }

  .recent-updates__track {
    margin: 0 6px;
  }

  .recent-card {
    padding: 18px 16px;
  }
}