{% extends "_partials/layout.njk" %}
{% block link %}
  <link rel="stylesheet" type="text/css" href="{{ url_for("/css/post.css") }}"/>
{% endblock link %}
{% block body %}
  <article class="post-content">
    <div class="post-inner{{ '--toc' if page.toc else '' }}">
      <div class="post-content__head">
        <div class="post-title">{{ (page.title or "未命名") | escape }}</div>
        <div class="post-info">
          {{ partial("_partials/macros/tags.njk", {tags: page.tags}) }}
          <span class="post-date">{{ date(page.date) }}</span>
        </div>
      </div>
      {% if page.toc %}
        <aside class="toc-outer">
          <div class="toc-title">目录</div>
          {{ toc(page.content, {list_number: false, max_depth: 4, class: 'post-toc'}) }}
          <a href="#" class="toc-top">回到顶部</a>
        </aside>
      {% endif %}
      <div class="post-content__body">
        {% if page.photos %}
          <div class="post-gallery">
            {% for photo in page.photos %}<img alt="cover" loading="lazy" decoding="async" src="{{ url_for(photo) | escape }}"/>{% endfor %}
          </div>
        {% endif %}
        {{ page.content }}
      </div>
    </div>
    {% if theme.mermaid.enable %}
      {# mermaid.url 可覆盖默认 CDN 拼接（完整本地路径或任意可达源，url_for 自动补子路径前缀） #}
      {% set mermaidUrl = theme.mermaid.url or ((theme.cdn or 'https://cdn.jsdelivr.net/npm') ~ '/mermaid@' ~ theme.mermaid.version ~ '/dist/mermaid.min.js') %}
      <script src='{{ url_for(mermaidUrl) | escape }}'
              onerror="(function(){var d=document.createElement('div');d.className='vendor-fail';d.textContent='Mermaid 图表加载失败（脚本源不可达），可配置 mermaid.url 指向可达源或本地文件';document.querySelector('.post-content__body').appendChild(d)})()"></script>
      <script>
        if (window.mermaid) {
          mermaid.initialize({{ theme.mermaid.options | dump | replace('</', '<\\/') }});
          // 10.x+ 用 mermaid.run()，9.x 用 mermaid.init()，做兼容 fallback
          if (typeof mermaid.run === 'function') {
            mermaid.run();
          } else if (typeof mermaid.init === 'function') {
            mermaid.init();
          }
        }
      </script>
    {% endif %}
  </article>
  <div class="post__foot">
    {% if theme.reward.enable %}
      {% include "_partials/components/reward.njk" %}
    {% endif %}
    {% include "_partials/components/post-nav.njk" %}
    {% if theme.related_post.enable %}
      {% include "_partials/components/related-post.njk" %}
    {% endif %}
    {% if theme.comments and theme.comments.enable %}
      {% include "_partials/components/comments.njk" %}
    {% endif %}
  </div>
{% endblock body %}
{% block script %}
  {# MathJax 仅在文章页按需加载：true 走默认 CDN；传字符串则以完整 URL 覆盖（本地路径或任意可达源） #}
  {% if theme.mathjax %}
    {% if theme.mathjax is string %}
      {% set mathjaxUrl = theme.mathjax %}
    {% else %}
      {% set mathjaxUrl = (theme.cdn or 'https://cdn.jsdelivr.net/npm') ~ '/mathjax@3.2.2/es5/tex-mml-chtml.js' %}
    {% endif %}
    <script id="MathJax-script"
            async
            src='{{ url_for(mathjaxUrl) | escape }}'
            onerror="(function(){var d=document.createElement('div');d.className='vendor-fail';d.textContent='数学公式渲染失败（MathJax 源不可达），可配置 mathjax 指向可达源或本地文件';document.querySelector('.post-content__body').appendChild(d)})()"></script>
  {% endif %}
{% endblock script %}
