{# 技能展示：分组技能条/标签，数据来自 theme.skills.groups（level 为 0-100 熟练度，省略则显示为标签） #}
<div class="skills" id="skills">
  <div class="skills__title">{{ (theme.skills.title or "技能") | escape }}</div>
  <div class="skills__groups">
    {% for g in theme.skills.groups %}
      <div class="skills__group">
        <div class="skills__group-name">{{ g.name | escape }}</div>
        <div class="skills__group-body">
          {# 有 level 的技能渲染为熟练度进度条 #}
          {% for s in g.items %}
            {% if s.level is number and s.level >= 0 and s.level <= 100 %}
              <div class="skill-item">
                <div class="skill-item__head">
                  {# title 供悬停查看完整名称（窄屏下名称可能折行） #}
                  <span class="skill-item__name" title="{{ s.name | escape }}">{{ s.name | escape }}</span>
                  <span class="skill-item__pct">{{ s.level }}%</span>
                </div>
                <div class="skill-item__bar" role="img"
                     aria-label="{{ s.name | escape }} {{ s.level }}%">
                  <div class="skill-item__fill" style="width: {{ s.level }}%"></div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
          {# 无 level（含越界/非数值）的技能统一收纳为一行标签，与进度条风格保持一致 #}
          {% set tagHtml %}
            {% for s in g.items %}
              {% if not (s.level is number and s.level >= 0 and s.level <= 100) %}
                <span class="skill-item__tag">{{ s.name | escape }}</span>
              {% endif %}
            {% endfor %}
          {% endset %}
          {% if tagHtml | trim %}
            <div class="skill-item__tags">{{ tagHtml | trim | safe }}</div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>
