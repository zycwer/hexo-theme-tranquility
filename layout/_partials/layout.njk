<!DOCTYPE html>
<html lang="{{ (config.language or 'zh-cn') | escape }}">
  <head>
    <meta charset="utf-8"/>
    {% if theme.google_ad.enable %}
      <meta name="google-adsense-account" content="{{ theme.google_ad.meta_tag | escape }}"/>
    {% endif %}
    <meta name="viewport" content="initial-scale=1.0, width=device-width"/>
    {# 安全策略：CSP / Referrer-Policy / Permissions-Policy，由 security.enable 控制 #}
    {% if theme.security and theme.security.enable %}
      {{ securityMeta() | safe }}
    {% endif %}
    {% set cdn = theme.cdn or 'https://cdn.jsdelivr.net/npm' %}
    <link rel="preconnect" href="{{ cdn | replace('/npm', '') }}" crossorigin/>
    {% if theme.slogan_hitokoto %}
      <link rel="preconnect" href="https://v1.hitokoto.cn" crossorigin/>
    {% endif %}
    {% if theme.baidu_analytics %}
      <link rel="preconnect" href="https://hm.baidu.com" crossorigin/>
    {% endif %}
    <title>
      {% if is_home() %}
        {{ config.title | escape }}
      {% elif is_post() %}
        {{ page.title | escape }} | {{ config.title | escape }}
      {% elif is_tag() %}
        {{ page.tag | escape }} | {{ config.title | escape }}
      {% else %}
        {{ (page.title or page.name or page.category) | escape }} | {{ config.title | escape }}
      {% endif %}
    </title>
    {% set desc = strip_html(page.excerpt) or page.description or config.description %}
    <meta name="description" content="{{ desc | escape }}"/>
    {% set _page_tags = page.tags.toArray() if page.tags and page.tags.toArray else (page.tags or []) %}
    <meta name="keywords" content="{% if page.tags and page.tags.length %}{% for _t in _page_tags %}{% if not loop.first %}, {% endif %}{{ _t.name | escape }}{% endfor %}{% else %}{{ config.keywords | escape }}{% endif %}"/>
    <link rel="canonical" href="{{ full_url_for(page.path or '/') | escape }}"/>
    {% if config.feed %}
      <link rel="alternate" type="application/rss+xml" title="{{ config.title | escape }}" href="{{ url_for(config.feed.path or '/atom.xml') }}"/>
    {% elif theme.recent_updates and theme.recent_updates.enable and theme.recent_updates.rss_url %}
      <link rel="alternate" type="application/rss+xml" title="{{ config.title | escape }}" href="{{ theme.recent_updates.rss_url | escape }}"/>
    {% endif %}
    {% if theme.pwa and theme.pwa.enable %}
      <link rel="manifest" href="{{ url_for('/manifest.json') }}"/>
      <meta name="theme-color" content="{{ (theme.pwa.theme_color or '#fcfcfb') | escape }}"/>
    {% endif %}
    {% if theme.favicon.apple_touch_icon %}
      <link rel="apple-touch-icon"
            sizes="180x180"
            href="{{ url_for(theme.favicon.apple_touch_icon) | escape }}"/>
    {% endif %}
    {% if theme.favicon.medium %}
      <link rel="icon"
            type="image/png"
            sizes="32x32"
            href="{{ url_for(theme.favicon.medium) | escape }}"/>
    {% endif %}
    {% if theme.favicon.small %}
      <link rel="icon"
            type="image/png"
            sizes="16x16"
            href="{{ url_for(theme.favicon.small) | escape }}"/>
    {% endif %}
    {% if theme.favicon.safari_pinned_tab %}
      <link rel="mask-icon"
            href="{{ url_for(theme.favicon.safari_pinned_tab) | escape }}"
            color="{{ (theme.android_chrome_color or theme.pwa.theme_color or '') | escape }}"/>
    {% endif %}
    {% if theme.favicon.android_manifest %}
      <link rel="manifest" href="{{ url_for(theme.favicon.android_manifest) | escape }}"/>
    {% endif %}
    {# Open Graph & Twitter Card：社交分享与 SEO #}
    {% set og_title = page.title or config.title %}
    {% set og_desc = desc %}
    {% set og_url = full_url_for(page.path or '/') %}
    {% set _og_img = page.cover or theme.index.photo or theme.logo %}
    {% set og_image = '' %}
    {% if _og_img %}
      {% if _og_img.indexOf('http') == 0 or _og_img.indexOf('//') == 0 %}
        {% set og_image = _og_img %}
      {% else %}
        {% set og_image = full_url_for(_og_img) %}
      {% endif %}
    {% endif %}
    <meta property="og:type" content="{% if is_post() %}article{% else %}website{% endif %}"/>
    <meta property="og:title" content="{{ og_title | escape }}"/>
    <meta property="og:description" content="{{ og_desc | escape }}"/>
    <meta property="og:url" content="{{ og_url | escape }}"/>
    <meta property="og:site_name" content="{{ config.title | escape }}"/>
    {% set _og_lang = (config.language or 'zh_CN') | replace('-', '_') %}
    <meta property="og:locale" content="{{ _og_lang | escape }}"/>
    {% if og_image %}<meta property="og:image" content="{{ og_image | escape }}"/>{% endif %}
    {% if is_post() %}
      {% if page.date %}<meta property="article:published_time" content="{{ date_xml(page.date) }}"/>{% endif %}
      {% if page.updated %}<meta property="article:modified_time" content="{{ date_xml(page.updated) }}"/>{% endif %}
    {% endif %}
    {% if is_post() and page.tags and page.tags.length %}
      {% for _t in page.tags.toArray() %}<meta property="article:tag" content="{{ _t.name | escape }}"/>{% endfor %}
    {% endif %}
    <meta name="twitter:card" content="{% if og_image %}summary_large_image{% else %}summary{% endif %}"/>
    <meta name="twitter:title" content="{{ og_title | escape }}"/>
    <meta name="twitter:description" content="{{ og_desc | escape }}"/>
    {% if og_image %}<meta name="twitter:image" content="{{ og_image | escape }}"/>{% endif %}
    {# 深色模式：首屏同步解析，避免 FOUC。模式由 color_mode 配置（light/dark/auto/time） #}
    <script>
      window.__THEME_MODE__ = {{ (theme.color_mode or 'light') | dump | replace('</', '<\\/') }};
      (function () {
        var m = window.__THEME_MODE__;
        var ts = {{ (theme.color_mode_time and theme.color_mode_time.start) or 18 }};
        var te = {{ (theme.color_mode_time and theme.color_mode_time.end) or 6 }};
        var o = null;
        try { o = localStorage.getItem('theme-override'); } catch (e) {}
        var t;
        if (o === 'light' || o === 'dark') {
          t = o;
        } else if (m === 'dark') {
          t = 'dark';
        } else if (m === 'auto') {
          t = (window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
        } else if (m === 'time') {
          var h = new Date().getHours();
          t = ts > te ? (h >= ts || h < te ? 'dark' : 'light') : (h >= ts && h < te ? 'dark' : 'light');
        } else {
          t = 'light';
        }
        document.documentElement.dataset.theme = t;
      })();
    </script>
    {% if theme.zh_font.enable %}
      {% include('./components/font.njk') %}
    {% endif %}
    <link rel="stylesheet"
          type="text/css"
          href='{{ url_for("/css/layout.css") }}'/>
    {% if theme.baidu_analytics %}
      <script>
        var _hmt = _hmt || [];
        (function () {
          var hm = document.createElement("script");
          hm.src = {{ ('https://hm.baidu.com/hm.js?' + theme.baidu_analytics) | dump | replace('</', '<\\/') }};
          var s = document.getElementsByTagName("script")[0];
          s
            .parentNode
            .insertBefore(hm, s);
        })();
      </script>
    {% endif %}
    {% block link %}{% endblock link %}
    {# JSON-LD 结构化数据：提升搜索引擎富摘要。用 dump 输出 JSON 字符串（自动处理引号/反斜杠/控制字符），再 replace('</','<\/') 防止闭合 script 标签 #}
    {% set jsonld_type = 'about' if (page.layout == 'about') else ('article' if is_post() else 'website') %}
    <script type="application/ld+json">
      {% if jsonld_type == 'website' %}
        {"@context":"https://schema.org","@type":"WebSite","name":{{ config.title | dump | replace('</', '<\\/') }},"description":{{ config.description | dump | replace('</', '<\\/') }},"url":{{ config.url | dump | replace('</', '<\\/') }}}
      {% elif jsonld_type == 'article' %}
        {% set _art_img = page.cover or theme.index.photo or theme.logo %}
        {% set _art_img_abs = '' %}
        {% if _art_img %}
          {% if _art_img.indexOf('http') == 0 or _art_img.indexOf('//') == 0 %}
            {% set _art_img_abs = _art_img %}
          {% else %}
            {% set _art_img_abs = full_url_for(_art_img) %}
          {% endif %}
        {% endif %}
        {% set _kw = '' %}
        {% if page.tags and page.tags.length %}
          {% for _t in page.tags.toArray() %}{% if not loop.first %}{% set _kw = _kw + ', ' %}{% endif %}{% set _kw = _kw + _t.name %}{% endfor %}
        {% endif %}
        {"@context":"https://schema.org","@type":"Article","headline":{{ page.title | dump | replace('</', '<\\/') }},"datePublished":"{{ page.date.format('YYYY-MM-DD') if page.date else '' }}","dateModified":"{{ page.updated.format('YYYY-MM-DD') if page.updated else '' }}","author":{"@type":"Person","name":{{ (config.author or config.title) | dump | replace('</', '<\\/') }}}{% if _art_img_abs %},"image":{{ _art_img_abs | dump | replace('</', '<\\/') }}{% endif %}{% if _kw %},"keywords":{{ _kw | dump | replace('</', '<\\/') }}{% endif %}}
      {% else %}
        {"@context":"https://schema.org","@type":"Person","name":{{ (config.author or config.title) | dump | replace('</', '<\\/') }},"description":{{ config.description | dump | replace('</', '<\\/') }}}
      {% endif %}
    </script>
  </head>
  <body>
    {% if theme.algolia and theme.algolia.enable %}
      <link rel="stylesheet" href="{{ cdn }}/@docsearch/css@3"/>
    {% elif theme.search and theme.search.enable %}
      {% include("./components/search-main.njk") %}
    {% endif %}
    {% set headClass = 'head--sticky' if theme.nav and theme.nav.sticky else 'head' %}
    <div class="{{ headClass }}">
      <div class="nav">
        <a href='{{ url_for("/") }}' class="nav-logo">
          <img alt="{{ config.title | escape }}" height="60" width="60" src="{{ url_for(theme.logo) }}"/>
        </a>
        <input id="navBtn" type="checkbox"/>
        <div class="nav-right">
          {% if theme.algolia and theme.algolia.enable %}
            <div class="search-outer" id="algolia-search"></div>
          {% elif theme.search and theme.search.enable %}
            <div class="search-outer">{% include("./components/search-btn.njk") %}</div>
          {% endif %}
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label="切换深色模式">
            <span class="theme-toggle__icon theme-toggle__icon--sun">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="1" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="23"/><line x1="1" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="23" y2="12"/><line x1="4.2" y1="4.2" x2="6.3" y2="6.3"/><line x1="17.7" y1="17.7" x2="19.8" y2="19.8"/><line x1="4.2" y1="19.8" x2="6.3" y2="17.7"/><line x1="17.7" y1="6.3" x2="19.8" y2="4.2"/></g></svg>
            </span>
            <span class="theme-toggle__icon theme-toggle__icon--moon">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="currentColor"/></svg>
            </span>
          </button>
          <div class="nav-menu">
            {% if theme.homepage_mode != 'landing' %}
              {% if theme.subpage.enable %}
                {% for nav in theme.subpage.pages %}
                  <a class="nav-menu-item" href="{{ url_for(nav.path or nav.name) | escape }}">{{ nav.title | escape }}</a>
                {% endfor %}
              {% else %}
                <a class="nav-menu-item" href='{{ url_for("/blog/") }}'>博客</a>
              {% endif %}
            {% endif %}
            {% if theme.nav and theme.nav.about %}
              <a class="nav-menu-item" href='{{ url_for("/about/") }}'>关于</a>
            {% endif %}
          </div>
        </div>
        <label class="nav-btn" for="navBtn"></label>
      </div>
    </div>
    <div class="body">
      {% block body %}{% endblock body %}
    </div>
    {% include "./components/foot.njk" %}
    <button id="back-to-top" class="back-to-top" type="button" aria-label="回到顶部">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 4l-8 8h5v8h6v-8h5z" fill="currentColor"/></svg>
    </button>
    {% if theme.algolia and theme.algolia.enable %}
      <script src="{{ cdn }}/@docsearch/js@3"></script>
      <script type="text/javascript">
        docsearch({
          appId: {{ theme.algolia.appId | dump | replace('</', '<\\/') }},
          apiKey: {{ theme.algolia.apiKey | dump | replace('</', '<\\/') }},
          indexName: {{ theme.algolia.indexName | dump | replace('</', '<\\/') }},
          insights: {{ 'true' if theme.algolia.insights else 'false' }},
          container: 'div#algolia-search',
          debug: {{ 'true' if theme.algolia.debug else 'false' }}
        });
      </script>
    {% elif theme.search and theme.search.enable %}
      <script src="{{url_for('js/search.js')}}"></script>
      <script>
        searchInitialize({{ url_for(theme.search.path) | dump | replace('</', '<\\/') }})
      </script>
    {% endif %}
    <script defer src="{{url_for('js/copy-code.js')}}"></script>
    <script defer src="{{url_for('js/theme.js')}}"></script>
    <script defer src="{{url_for('js/back-to-top.js')}}"></script>
    {% if theme.pwa and theme.pwa.enable %}
      <script>
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', function () {
            navigator.serviceWorker.register('{{ url_for("/sw.js") }}').catch(function(){});
          });
        }
      </script>
    {% endif %}
    {% block script %}{% endblock script %}
  </body>
</html>