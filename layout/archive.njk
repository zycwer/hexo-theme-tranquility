{% extends "_partials/layout.njk" %}
{% block link %}
  <link rel="stylesheet" type="text/css" href="{{ url_for("/css/archive.css") }}" />
{% endblock link %}
{% block body %}
  <div class="wall wall-archive">
    <div class="wall-main">
      <div class="wall-archive-title">归档</div>
      <div class="wall-archive-description">
        共 {{ site.posts.length if site.posts.length else site.posts.size }} 篇文章
      </div>
    </div>
  </div>
  <div class="archive">
    {# 按年份分组：遍历中年份变化时输出年份标题，形成分组结构 #}
    {% set postsArr = page.posts.toArray() if page.posts.toArray else page.posts %}
    {% if not postsArr.length %}
      <p class="archive-empty">暂无文章。</p>
    {% else %}
      {% set currentYear = null %}
      <div class="archive-list">
        {% for post in postsArr %}
          {% set year = date(post.date, 'YYYY') %}
          {% if year !== currentYear %}
            {% set currentYear = year %}
            <div class="archive-year">{{ year }}</div>
          {% endif %}
          <a class="archive-item" href="{{ url_for(post.path) }}">
            <span class="archive-item__date">{{ date(post.date, 'MM-DD') }}</span>
            <span class="archive-item__title">{{ (post.title or '未命名') | escape }}</span>
          </a>
        {% endfor %}
      </div>
    {% endif %}
    {% if page.prev or page.next %}<div class="paginator">{{ paginator({"prev_next": false}) }}</div>{% endif %}
  </div>
{% endblock body %}
